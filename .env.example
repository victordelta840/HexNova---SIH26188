SCREENING_APP_NAME=Identity Screening System API
SCREENING_APP_ENV=development
SCREENING_API_V1_PREFIX=/api/v1
SCREENING_CORS_ORIGINS=http://localhost:3000
SCREENING_LOG_LEVEL=INFO
SCREENING_DATABASE_URL=postgresql+psycopg://screening:change-me@localhost:5432/screening
SCREENING_MAX_UPLOAD_SIZE_BYTES=10485760
SCREENING_JWT_SECRET_KEY=
SCREENING_JWT_ALGORITHM=HS256
SCREENING_ACCESS_TOKEN_EXPIRE_MINUTES=30
SCREENING_DEMO_OFFICER_PASSWORD=
SCREENING_DEMO_ADMIN_PASSWORD=
SCREENING_REFERENCE_PROFILE_LOCK_SECRET=
DEEP_LEARNING_ENABLED=true
DEEP_MODEL_NAME=efficientnet_b0
DEEP_DEVICE=cpu
DEEP_GLOBAL_SIMILARITY_THRESHOLD=0.75
DEEP_REGION_SIMILARITY_THRESHOLD=0.70
DEEP_ANOMALY_THRESHOLD=0.60
AUTOENCODER_ENABLED=false
DEMO_MODE=true